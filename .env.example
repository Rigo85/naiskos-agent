NAISKOS_HOST=127.0.0.1
NAISKOS_PORT=8080
NAISKOS_DATA_ROOT=/var/lib/naiskos
NAISKOS_WEB_ROOT=/opt/naiskos/browser
NAISKOS_CENTRAL_URL=https://naiskos.example.com
# Credencial de la imagen de instalación para registrar el equipo en el primer arranque.
NAISKOS_DEVICE_BOOTSTRAP_TOKEN=
NAISKOS_FRAME_ID=
NAISKOS_AGENT_TOKEN=
NAISKOS_TELEGRAM_BOT_USERNAME=naiskosbot
NAISKOS_DEVICE_NAME=
NAISKOS_FRAME_WIDTH=1280
NAISKOS_FRAME_HEIGHT=800
NAISKOS_SYNC_INTERVAL_MS=5000
NAISKOS_TELEMETRY_HEARTBEAT_INTERVAL_MS=60000
NAISKOS_TELEMETRY_FULL_INTERVAL_MS=300000
# Ubicacion/clima se sincronizan aparte del manifiesto para no consultar cada 5 s.
NAISKOS_WEATHER_SYNC_INTERVAL_MS=60000
NAISKOS_DISK_BLOCK_PERCENT=90
