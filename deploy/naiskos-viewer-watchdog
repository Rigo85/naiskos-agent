#!/bin/sh

set -u

NAISKOS_VIEWER_WATCHDOG_URL="${NAISKOS_VIEWER_WATCHDOG_URL:-http://127.0.0.1:8080/api/v1/viewer/restart-needed}"
grace_until=0
was_unavailable=0

while :; do
  sleep 15
  pid="$(/usr/bin/pgrep -o -x chromium 2>/dev/null || true)"
  if [ -z "${pid}" ]; then
    was_unavailable=1
    continue
  fi
  process_state="$(/usr/bin/ps -o stat= -p "${pid}" 2>/dev/null | /usr/bin/tr -d ' ' || true)"
  case "${process_state}" in
    T*) was_unavailable=1; continue ;;
  esac
  now="$(date +%s)"
  if [ "${was_unavailable}" -eq 1 ]; then
    grace_until=$((now + 60))
    was_unavailable=0
  fi
  [ "${now}" -ge "${grace_until}" ] || continue
  status="$(/usr/bin/curl --fail --silent --show-error --max-time 3 \
    "${NAISKOS_VIEWER_WATCHDOG_URL}" 2>/dev/null || true)"
  [ "${status}" = '{"restart":true}' ] || continue
  /usr/bin/pkill -TERM -x chromium 2>/dev/null || true
done
