#!/bin/sh

set -u

NAISKOS_VIEWER_WATCHDOG_URL="${NAISKOS_VIEWER_WATCHDOG_URL:-http://127.0.0.1:8080/api/v1/viewer/restart-needed}"

while :; do
  sleep 15
  status="$(/usr/bin/curl --fail --silent --show-error --max-time 3 \
    "${NAISKOS_VIEWER_WATCHDOG_URL}" 2>/dev/null || true)"
  [ "${status}" = '{"restart":true}' ] || continue
  /usr/bin/pkill -TERM -x chromium 2>/dev/null || true
done
