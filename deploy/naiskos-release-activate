#!/bin/sh
set -eu

request=/var/lib/naiskos/updates/activation-request.json
observation=/var/lib/naiskos/updates/observation.json
public_key=/etc/naiskos/release-signing-public.pem
baseline=/etc/naiskos/baseline.json
helper=/opt/naiskos/bin/naiskos-release-helper.mjs
migration_state_root=/var/lib/naiskos/migrations
force=0
[ "${1:-}" = "--force" ] && force=1

exec 9>/run/naiskos-release-activate.lock
/usr/bin/flock --nonblock 9 || exit 0

"$helper" repair-migration-permissions "$migration_state_root"

report() {
  "$helper" report "$1" "$2" "$3" "${4:-}" || true
}

restart_runtime() {
  systemctl restart naiskos-agent.service
  pkill -TERM -x chromium 2>/dev/null || true
}

local_health() {
  curl -fsS --max-time 10 http://127.0.0.1:8080/api/v1/health |
    /opt/node24/bin/node -e '
      let body="";
      process.stdin.on("data",chunk=>body+=chunk).on("end",()=>{
        try {
          const health=JSON.parse(body);
          process.exit(health.ok===true && health.state==="ready" ? 0 : 1);
        } catch { process.exit(1); }
      });
    '
}

rollback_migrations() {
  migration_list=$1
  [ -n "$migration_list" ] || return 0
  rollback_ok=1
  old_ifs=$IFS
  IFS=','
  for migration_id in $migration_list; do
    if ! "$helper" rollback-migration "$migration_id" "$baseline" "$migration_state_root"; then
      rollback_ok=0
    fi
  done
  IFS=$old_ifs
  [ "$rollback_ok" -eq 1 ]
}

if [ -s "$observation" ]; then
  values=$(/opt/node24/bin/node -e '
    const s=JSON.parse(require("fs").readFileSync(process.argv[1],"utf8"));
    process.stdout.write([s.campaignId,s.releaseId,s.previous,s.activatedAt,s.observeMinutes,s.failures||0,(s.migrations||[]).join(",")].join("|"));
  ' "$observation")
  IFS='|' read -r campaign release previous activated_at observe_minutes failures applied_migrations <<EOF
$values
EOF
  if local_health; then
    activated_epoch=$(date -d "$activated_at" +%s)
    now_epoch=$(date +%s)
    if [ $((now_epoch - activated_epoch)) -ge $((observe_minutes * 60)) ]; then
      report "$campaign" "$release" installed
      rm -f -- "$observation"
    fi
  else
    failures=$((failures + 1))
    if [ "$failures" -ge 3 ] && [ -n "$previous" ] && [ -d "/opt/naiskos/releases/$previous" ]; then
      if ! rollback_migrations "$applied_migrations"; then
        report "$campaign" "$release" failed "Falló el rollback de una migración del baseline"
        exit 1
      fi
      ln -sfn "/opt/naiskos/releases/$previous" /opt/naiskos/current.rollback
      mv -Tf /opt/naiskos/current.rollback /opt/naiskos/current
      restart_runtime
      report "$campaign" "$release" rolled_back "La salud local falló tres veces durante la observación"
      rm -f -- "$observation"
    else
      /opt/node24/bin/node -e '
        const fs=require("fs"),p=process.argv[1],s=JSON.parse(fs.readFileSync(p,"utf8"));
        s.failures=Number(process.argv[2]); fs.writeFileSync(p+".tmp",JSON.stringify(s)+"\n",{mode:0o600}); fs.renameSync(p+".tmp",p);
      ' "$observation" "$failures"
    fi
  fi
  exit 0
fi

[ -s "$request" ] || exit 0
values=$($helper verify-request "$request" "$public_key" "$baseline")
IFS='|' read -r campaign release manifest archive window_from window_until observe_minutes <<EOF
$values
EOF

if [ "$force" -ne 1 ]; then
  now=$(TZ=America/Lima date +%H%M)
  from=$(printf '%s' "$window_from" | tr -d ':')
  until=$(printf '%s' "$window_until" | tr -d ':')
  if [ "$from" -le "$until" ]; then
    [ "$now" -ge "$from" ] && [ "$now" -lt "$until" ] || exit 0
  else
    [ "$now" -ge "$from" ] || [ "$now" -lt "$until" ] || exit 0
  fi
fi

report "$campaign" "$release" activating
staging="/opt/naiskos/releases/.staging-$release"
rm -rf -- "$staging"
mkdir -p -- "$staging"
if tar -tzf "$archive" | grep -Eq '(^/|(^|/)\.\.(/|$))'; then
  report "$campaign" "$release" failed "El archivo contiene rutas no permitidas"
  rm -rf -- "$staging"
  exit 1
fi
if tar -tvzf "$archive" | awk 'substr($1,1,1)=="l" || substr($1,1,1)=="h" { found=1 } END { exit found ? 0 : 1 }'; then
  report "$campaign" "$release" failed "El archivo contiene enlaces no permitidos"
  rm -rf -- "$staging"
  exit 1
fi
tar -xzf "$archive" -C "$staging" --no-same-owner --no-same-permissions
$helper verify-extracted "$manifest" "$staging"

previous=$(basename "$(readlink -f /opt/naiskos/current 2>/dev/null || true)")
applied_migrations=
for migration in $($helper migrations "$manifest"); do
  migration_root="$staging/migrations/$migration"
  descriptor="$migration_root/migration.json"
  if ! migration_result=$($helper apply-migration "$descriptor" "$migration_root" "$baseline" "$migration_state_root"); then
    rollback_migrations "$applied_migrations" || true
    report "$campaign" "$release" failed "No se pudo aplicar la migración declarativa: $migration"
    rm -rf -- "$staging"
    exit 1
  fi
  migration_id=${migration_result#*|}
  if [ -n "$applied_migrations" ]; then
    applied_migrations="$migration_id,$applied_migrations"
  else
    applied_migrations=$migration_id
  fi
done

destination="/opt/naiskos/releases/$release"
[ ! -e "$destination" ] || { report "$campaign" "$release" failed "La versión ya existe de forma inesperada"; exit 1; }
mv -- "$staging" "$destination"
cp -- "$manifest" "$destination/release.json"
chown -R root:root "$destination"
ln -sfn "$destination" /opt/naiskos/current.next
mv -Tf /opt/naiskos/current.next /opt/naiskos/current

/opt/node24/bin/node -e '
  const fs=require("fs"),p=process.argv[1];
  const migrations=process.argv[6] ? process.argv[6].split(",") : [];
  const s={campaignId:process.argv[2],releaseId:process.argv[3],previous:process.argv[4],activatedAt:new Date().toISOString(),observeMinutes:Number(process.argv[5]),failures:0,migrations};
  fs.writeFileSync(p+".tmp",JSON.stringify(s)+"\n",{mode:0o600}); fs.renameSync(p+".tmp",p);
' "$observation" "$campaign" "$release" "$previous" "$observe_minutes" "$applied_migrations"
rm -f -- "$request"
restart_runtime
sleep 5
if local_health; then
  report "$campaign" "$release" observing
else
  report "$campaign" "$release" observing "La primera comprobación de salud quedó pendiente"
fi
