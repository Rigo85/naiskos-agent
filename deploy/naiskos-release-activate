#!/bin/sh
set -eu

request=/var/lib/naiskos/updates/activation-request.json
observation=/var/lib/naiskos/updates/observation.json
failed_root=/var/lib/naiskos/updates/failed
public_key=/etc/naiskos/release-signing-public.pem
baseline=/etc/naiskos/baseline.json
helper=/opt/naiskos/bin/naiskos-release-helper.mjs
migration_state_root=/var/lib/naiskos/migrations
credentials=/var/lib/naiskos/device-credentials.json
force=0
[ "${1:-}" = "--force" ] && force=1

exec 9>/run/naiskos-release-activate.lock
/usr/bin/flock --nonblock 9 || exit 0

report() {
  "$helper" report "$1" "$2" "$3" "${4:-}"
}

quarantine_request() {
  failure_id=${1:-invalid-request}
  mkdir -p -- "$failed_root"
  chmod 0700 "$failed_root"
  failed_request="$failed_root/$failure_id-$(date -u +%Y%m%dT%H%M%SZ)-$$.json"
  mv -f -- "$request" "$failed_request"
  chmod 0600 "$failed_request"
  echo "Solicitud de activación en cuarentena: $failed_request" >&2
}

restart_runtime() {
  /opt/node24/bin/node /opt/naiskos/bin/naiskos-release-runtime.mjs restart
}

local_health() {
  /opt/node24/bin/node /opt/naiskos/bin/naiskos-release-runtime.mjs health "$release"
}

rollback_migrations() {
  migration_list=$1
  [ -n "$migration_list" ] || return 0
  rollback_ok=1
  old_ifs=$IFS
  IFS=','
  for migration_id in $migration_list; do
    if ! "$helper" rollback-migration "$migration_id" "$baseline" "$migration_state_root"; then
      rollback_ok=0
    fi
  done
  IFS=$old_ifs
  [ "$rollback_ok" -eq 1 ]
}

if [ -s "$observation" ]; then
  /opt/node24/bin/node /opt/naiskos/bin/naiskos-release-runtime.mjs tick
  exit 0
fi

if [ -d /var/lib/naiskos/updates/release-reports ]; then
  /opt/node24/bin/node /opt/naiskos/bin/naiskos-release-runtime.mjs tick
fi

[ -s "$request" ] || exit 0
if ! values=$($helper verify-request "$request" "$public_key" "$baseline"); then
  quarantine_request invalid-request
  exit 1
fi
IFS='|' read -r campaign release manifest archive window_from window_until observe_minutes expires_at <<EOF
$values
EOF

expires_epoch=$(date -d "$expires_at" +%s)
now_epoch=$(date +%s)
if [ "$now_epoch" -ge "$expires_epoch" ]; then
  report "$campaign" "$release" failed "La autorización local de la release venció"
  quarantine_request "$release-expired"
  exit 1
fi

if [ "$force" -ne 1 ]; then
  now=$(TZ=America/Lima date +%H%M)
  from=$(printf '%s' "$window_from" | tr -d ':')
  until=$(printf '%s' "$window_until" | tr -d ':')
  if [ "$from" -le "$until" ]; then
    [ "$now" -ge "$from" ] && [ "$now" -lt "$until" ] || exit 0
  else
    [ "$now" -ge "$from" ] || [ "$now" -lt "$until" ] || exit 0
  fi
fi

if authorization=$($helper authorize-release "$campaign" "$release" "$expires_at" "$credentials"); then
  :
else
  authorization_status=$?
  if [ "$authorization_status" -eq 3 ]; then
    report "$campaign" "$release" failed "La campaña ya no autoriza esta activación"
    quarantine_request "$release-not-authorized"
    exit 1
  fi
  echo "No se pudo revalidar la campaña; la activación queda pendiente" >&2
  exit 0
fi
[ "$authorization" = "authorized" ] || exit 1

if ! /opt/node24/bin/node /opt/naiskos/bin/naiskos-release-runtime.mjs can-activate; then
  exit 0
fi

"$helper" repair-migration-permissions "$migration_state_root" >/dev/null

report "$campaign" "$release" activating
staging="/opt/naiskos/releases/.staging-$release"

terminal_failure() {
  message=$1
  report "$campaign" "$release" failed "$message"
  quarantine_request "$release"
  rm -rf -- "$staging"
  if [ "${runtime_stopped:-0}" = 1 ]; then
    /opt/node24/bin/node /opt/naiskos/bin/naiskos-kiosk-control.mjs start || true
  fi
  exit 1
}

rm -rf -- "$staging"
mkdir -p -- "$staging"
if tar -tzf "$archive" | grep -Eq '(^/|(^|/)\.\.(/|$))'; then
  terminal_failure "El archivo contiene rutas no permitidas"
fi
if tar -tvzf "$archive" | awk 'substr($1,1,1)=="l" || substr($1,1,1)=="h" { found=1 } END { exit found ? 0 : 1 }'; then
  terminal_failure "El archivo contiene enlaces no permitidos"
fi
if ! tar -xzf "$archive" -C "$staging" --no-same-owner --no-same-permissions; then
  terminal_failure "No se pudo extraer el archivo de la release"
fi
if ! $helper verify-extracted "$manifest" "$staging"; then
  terminal_failure "La release extraída no coincide con el manifiesto"
fi

previous=$(basename "$(readlink -f /opt/naiskos/current 2>/dev/null || true)")
if ! /opt/node24/bin/node /opt/naiskos/bin/naiskos-kiosk-control.mjs stop; then
  terminal_failure "El kiosco no pudo cerrarse; se conserva la release activa"
fi
runtime_stopped=1
applied_migrations=
for migration in $($helper migrations "$manifest"); do
  migration_root="$staging/migrations/$migration"
  descriptor="$migration_root/migration.json"
  if ! migration_result=$($helper apply-migration "$descriptor" "$migration_root" "$baseline" "$migration_state_root"); then
    rollback_migrations "$applied_migrations" || true
    terminal_failure "No se pudo aplicar la migración declarativa: $migration"
  fi
  migration_status=${migration_result%%|*}
  migration_id=${migration_result#*|}
  case "$migration_status" in
    applied)
      if [ -n "$applied_migrations" ]; then
        applied_migrations="$migration_id,$applied_migrations"
      else
        applied_migrations=$migration_id
      fi
      ;;
    already-current) ;;
    *)
      rollback_migrations "$applied_migrations" || true
      terminal_failure "Resultado inesperado de migración: $migration"
      ;;
  esac
done

destination="/opt/naiskos/releases/$release"
[ ! -e "$destination" ] || terminal_failure "La versión ya existe de forma inesperada"
mv -- "$staging" "$destination"
cp -- "$manifest" "$destination/release.json"
chown -R root:root "$destination"
ln -sfn "$destination" /opt/naiskos/current.next
mv -Tf /opt/naiskos/current.next /opt/naiskos/current

/opt/node24/bin/node -e '
  const fs=require("fs"),p=process.argv[1];
  const migrations=process.argv[6] ? process.argv[6].split(",") : [];
  const s={campaignId:process.argv[2],releaseId:process.argv[3],previous:process.argv[4],activatedAt:new Date().toISOString(),observeMinutes:Number(process.argv[5]),failures:0,migrations};
  fs.writeFileSync(p+".tmp",JSON.stringify(s)+"\n",{mode:0o600}); fs.renameSync(p+".tmp",p);
' "$observation" "$campaign" "$release" "$previous" "$observe_minutes" "$applied_migrations"
rm -f -- "$request"
restart_runtime
sleep 5
if local_health; then
  report "$campaign" "$release" observing
else
  report "$campaign" "$release" observing "La primera comprobación de salud quedó pendiente"
fi
