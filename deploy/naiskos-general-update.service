[Unit]
Description=Ejecuta una campaña general escalonada del SO
After=network-online.target systemd-time-wait-sync.service naiskos-agent.service naiskos-security-update.service
Wants=network-online.target systemd-time-wait-sync.service
StartLimitIntervalSec=6h
StartLimitBurst=8

[Service]
Type=oneshot
EnvironmentFile=/etc/naiskos/agent.env
ExecStart=/opt/naiskos/bin/naiskos-system-maintenance general
TimeoutStartSec=3h
Restart=on-failure
RestartSec=15min
RestartPreventExitStatus=2
Nice=10
IOSchedulingClass=idle
UMask=0077
ProtectHome=true
PrivateTmp=true
