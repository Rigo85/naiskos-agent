{
  "name": "naiskos-agent",
  "version": "0.1.0",
  "license": "AGPL-3.0-only",
  "private": true,
  "description": "Agente local de Naiskos para Raspberry Pi",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@fastify/static": "10.1.3",
    "fastify": "5.12.3",
    "qrcode": "1.5.4"
  },
  "devDependencies": {
    "@types/node": "24.10.13",
    "@types/qrcode": "1.5.6",
    "tsx": "4.20.6",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  }
}
